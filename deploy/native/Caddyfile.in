# Installed by scripts/native/install.sh (HTTPS mode). Caddy's internal CA, like the old container.
{
    # Browsers omit SNI when the panel is opened by IP address.
    default_sni @HOST@
    # Same as the old RIGDECK_LISTEN: 0.0.0.0 for every interface, or one LAN address.
    default_bind @LISTEN@
}

@HOST@ {
    tls internal
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
        -Server
    }
    reverse_proxy 127.0.0.1:8080
}
